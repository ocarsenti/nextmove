# Copie ce fichier en .env et remplis les valeurs réelles.
# .env n'est jamais commité (voir .gitignore).

# --- Anthropic (extraction de signaux depuis les descriptions de poste) ---
ANTHROPIC_API_KEY=

# --- Alerte email de calibration des archétypes (scripts/check_calibration_and_alert.py) ---
# SMTP classique — Gmail (mot de passe d'application requis), OVH, ou tout
# autre fournisseur SMTP que tu as déjà.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ARCHETYPE_CALIBRATION_ALERT_TO=
